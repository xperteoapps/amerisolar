{
  "name": "amerisolar",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:facts": "node scripts/check-products.mjs",
    "prepare": "husky",
    "seed:build": "node scripts/build-seed.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.6.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.13"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,md,css,yml}": "prettier --write"
  }
}
