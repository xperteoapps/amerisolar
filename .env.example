# Skopiuj do apps/web/.env.local (lokalnie). Na Vercel ustaw w Project → Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Tylko serwer — nigdy z prefiksem NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Odbiorcy zapytań z formularza (po przecinku). Puste = e-mail serwisu z lib/sites.ts (office@amerisolar.pl)
LEAD_NOTIFY_EMAILS=office@amerisolar.pl
# Nadawca maili z formularza — domena musi być zweryfikowana w Resend
LEAD_FROM_EMAIL="Formularz amerisolar.pl <formularz@amerisolar.pl>"
HF_API_KEY_ID=
HF_API_KEY_SECRET=
