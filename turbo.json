{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../../data/**", "../../packages/**/src/**"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_*", "SUPABASE_*", "RESEND_API_KEY", "TURNSTILE_SECRET", "LEAD_NOTIFY_EMAILS"]
    },
    "lint": {},
    "typecheck": {},
    "test": { "inputs": ["$TURBO_DEFAULT$", "../../data/**"] },
    "dev": { "cache": false, "persistent": true }
  }
}
